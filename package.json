{
  "name": "close-the-ads",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "verify": "npm run test && npm run build && npm run test:browser",
    "test:benchmark": "node --test benchmark/tests/*.test.mjs",
    "test:benchmark:browser": "node --test benchmark/browser.test.mjs",
    "benchmark": "node benchmark/cli.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=22"
  }
}
